# Copy to a private ignored environment file and generate unique credentials.
WEB_PORT=23080
MARIADB_PORT_ON_HOST=23306
MARIADB_ROOT_PASSWORD=
MARIADB_USER=hmv_app
MARIADB_PASSWORD=
MARIADB_DATABASE=home_media_test
DATABASE_URL=mysql://${MARIADB_USER}:${MARIADB_PASSWORD}@db:3306/${MARIADB_DATABASE}
SHADOW_DATABASE_URL=mysql://${MARIADB_USER}:${MARIADB_PASSWORD}@db:3306/${MARIADB_DATABASE}_shadow
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=
APP_ALBUM_ROOT_PATH=/mnt/albums
APP_STORAGE_PATH=/mnt/storage
APP_SESSION_SECRET=
LONG_PROCESS_TIMEOUT_SEC=50
PROCESS_TOKEN=
IS_BACKGROUND_PROCESS_ENABLED=1
SESSION_COOKIE_SECURE=false

# Scheduler delays after completed requests; catch up only after deadline-limited backlog.
BACKGROUND_INTERVAL_SEC=180
BACKGROUND_CATCHUP_INTERVAL_SEC=30
BACKGROUND_MAX_BACKOFF_SEC=900
