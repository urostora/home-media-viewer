{
  "name": "home-media-viewer",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src __tests__ --ext .ts,.tsx",
    "prettier-format": "prettier --config .prettierrc --write 'src/**/*.ts' '__tests__/**/*.ts'",
    "bgprocess": "npx ts-node -r tsconfig-paths/register ./src/backgroundProcesses/updateMetadata.ts",
    "test": "jest --collect-coverage",
    "typecheck": "next typegen && tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@prisma/client": "5.8.1",
    "bcrypt": "6.0.0",
    "exifreader": "^4.12.0",
    "ffprobe": "^1.1.2",
    "iron-session": "9.0.1",
    "jimp": "^0.22",
    "mime-types": "^2.1.35",
    "next": "16.4.3",
    "pigeon-maps": "^0.21.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^6.1.3",
    "@testing-library/react": "16.3.3",
    "@types/bcrypt": "^5.0.0",
    "@types/expect-puppeteer": "^5.0.6",
    "@types/ffprobe": "^1.1.4",
    "@types/jest": "^29.5.5",
    "@types/jest-environment-puppeteer": "^5.0.6",
    "@types/mime-types": "^2.1.1",
    "@types/node": "26.6.5",
    "@types/node-fetch": "^2.6.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^8.8.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-puppeteer": "^9.0.1",
    "msw": "^1.3.2",
    "node-fetch": "2.7.0",
    "prettier": "^3",
    "prisma": "5.8.1",
    "puppeteer": "^21.5.1",
    "sass": "^1.62.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.2",
    "whatwg-fetch": "^3.6.19",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.72.0"
  },
  "prisma": {
    "seed": "./node_modules/.bin/ts-node prisma/seed.ts"
  },
  "overrides": {
    "yargs@^17": "17.7.3"
  }
}
