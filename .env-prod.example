# Copy to a private ignored environment file and generate unique credentials.
WEB_PORT=25080
MARIADB_PORT_ON_HOST=25306
MARIADB_ROOT_PASSWORD=
MARIADB_USER=hmv_app
MARIADB_PASSWORD=
MARIADB_DATABASE=home_media
DATABASE_URL=mysql://${MARIADB_USER}:${MARIADB_PASSWORD}@db:3306/${MARIADB_DATABASE}
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=
APP_ALBUM_ROOT_PATH=/mnt/albums
APP_STORAGE_PATH=/mnt/storage
APP_SESSION_SECRET=
LONG_PROCESS_TIMEOUT_SEC=120
PROCESS_TOKEN=
WEB_BIND_ADDRESS=127.0.0.1
MARIADB_MIGRATION_USER=hmv_migration
MARIADB_MIGRATION_PASSWORD=
MIGRATION_DATABASE_URL=mysql://${MARIADB_MIGRATION_USER}:${MARIADB_MIGRATION_PASSWORD}@db:3306/${MARIADB_DATABASE}
SESSION_COOKIE_SECURE=true

# Single-host operational budget; reserve RAM/CPU for the OS, proxy and backup jobs.
APP_THUMBNAIL_SUBDIRECTORY=thumbnail
MEDIA_WORKERS=2
DB_CONNECTION_LIMIT=5
DB_CPUS=1.0
DB_MEMORY=1g
DB_BUFFER_POOL_SIZE=384M
DB_MAX_CONNECTIONS=40
APP_CPUS=1.0
APP_MEMORY=1g
BACKGROUND_CPUS=2.0
BACKGROUND_MEMORY=2g
SCHEDULER_CPUS=0.25
SCHEDULER_MEMORY=128m
MIN_STORAGE_FREE_BYTES=268435456
